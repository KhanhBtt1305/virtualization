DB_HOST=your-aiven-host
DB_PORT=25444
DB_USER=avnadmin
DB_PASSWORD=replace-with-your-password
DB_NAME=defaultdb

# DB_SSL=true enables TLS. Certificate verification is enabled by default.
DB_SSL=true
# Set false only if your provider requires TLS without certificate verification.
DB_SSL_REJECT_UNAUTHORIZED=false
# For certificate verification, set DB_SSL_REJECT_UNAUTHORIZED=true and provide the CA file path or PEM:
# DB_SSL_CA=ca.pem
